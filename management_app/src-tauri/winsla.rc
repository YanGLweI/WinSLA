#include <windows.h>

// 图标（路径相对于 src-tauri，RC 中使用双反斜杠）
1 ICON "..\\..\\assets\\winsla.ico"

// 应用清单（UAC requireAdministrator）
1 RT_MANIFEST "app.manifest"

// 版本信息
1 VERSIONINFO
FILEVERSION 2,2,0,0
PRODUCTVERSION 2,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ylw"
            VALUE "FileDescription", "WinSLA Dual-Account Authentication Management"
            VALUE "FileVersion", "2.2.0"
            VALUE "LegalCopyright", "MIT License - ylw"
            VALUE "ProductName", "WinSLA Management"
            VALUE "ProductVersion", "2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
